# Deterministic local adapter; never enable this in a production Pages build.
PUBLIC_REPO_APPS_FAKE=1
PUBLIC_REPO_OWNER=local
PUBLIC_REPO_NAME=quick-log
PUBLIC_REPO_BRANCH=main

# Optional GitHub OAuth App Device Flow configuration.
# PUBLIC_GITHUB_DEVICE_CLIENT_ID=
# Use public_repo for a public app repository or repo for a private repository.
PUBLIC_GITHUB_DEVICE_SCOPE=public_repo

# Immutable private Todo plugin revision. Repository identity remains fixed in source.
PUBLIC_TODO_PLUGIN_SHA=1542da707d725331ec9d73cedb6ff2af272ea0f5
